              "query": [
                { "key": "city", "value": "New Delhi" },
                { "key": "date", "value": "2020-01-01" }
              ]
            },
            "description": "Still HTTP 200. `metrics.orders` should be 0 and `narrative` should say no orders matched."
          },
          "event": [
            {
              "listen": "test",
